  "lines": [
    {"text":"Nobody invented kindness.","start":0.9,"end":3.91,"words":[{"w":"Nobody","start":0.9,"end":1.741},{"w":"invented","start":1.791,"end":2.825},{"w":"kindness","start":2.875,"end":3.91}]},
    {"text":"People gave it a name.","start":3.91,"end":9.25,"words":[{"w":"People","start":3.91,"end":5.505},{"w":"gave","start":5.555,"end":6.746},{"w":"it","start":6.796,"end":7.52},{"w":"a","start":7.57,"end":8.009},{"w":"name","start":8.059,"end":9.25}]},
    {"text":"But kindness was already there.","start":9.25,"end":13.44,"words":[{"w":"But","start":9.25,"end":9.796},{"w":"kindness","start":9.846,"end":10.952},{"w":"was","start":11.002,"end":11.547},{"w":"already","start":11.597,"end":12.602},{"w":"there","start":12.652,"end":13.44}]},
    {"text":"Whenever someone helps another person,","start":13.44,"end":20.26,"words":[{"w":"Whenever","start":13.44,"end":14.964},{"w":"someone","start":15.014,"end":16.399},{"w":"helps","start":16.449,"end":17.536},{"w":"another","start":17.586,"end":18.971},{"w":"person","start":19.021,"end":20.26}]},
    {"text":"shares their food,","start":20.26,"end":21.43,"words":[{"w":"shares","start":20.26,"end":20.668},{"w":"their","start":20.718,"end":21.075},{"w":"food","start":21.125,"end":21.43}]},
    {"text":"comforts a friend,","start":21.43,"end":26.57,"words":[{"w":"comforts","start":21.43,"end":23.905},{"w":"a","start":23.955,"end":24.508},{"w":"friend","start":24.558,"end":26.57}]},
    {"text":"or tells the truth even when it is hard,","start":26.57,"end":34.13,"words":[{"w":"or","start":26.57,"end":27.115},{"w":"tells","start":27.165,"end":28.218},{"w":"the","start":28.268,"end":28.997},{"w":"truth","start":29.047,"end":30.1},{"w":"even","start":30.15,"end":31.047},{"w":"when","start":31.097,"end":31.994},{"w":"it","start":32.044,"end":32.589},{"w":"is","start":32.639,"end":33.183},{"w":"hard","start":33.233,"end":34.13}]},
    {"text":"something special happens.","start":34.13,"end":37.26,"words":[{"w":"something","start":34.13,"end":35.265},{"w":"special","start":35.315,"end":36.263},{"w":"happens","start":36.313,"end":37.26}]},
    {"text":"People come closer.","start":37.26,"end":39.21,"words":[{"w":"People","start":37.26,"end":37.934},{"w":"come","start":37.984,"end":38.486},{"w":"closer","start":38.536,"end":39.21}]},
    {"text":"Trust grows.","start":39.21,"end":42.77,"words":[{"w":"Trust","start":39.21,"end":40.965},{"w":"grows","start":41.015,"end":42.77}]},
    {"text":"And together they become stronger.","start":42.77,"end":47.87,"words":[{"w":"And","start":42.77,"end":43.388},{"w":"together","start":43.438,"end":44.69},{"w":"they","start":44.74,"end":45.5},{"w":"become","start":45.55,"end":46.568},{"w":"stronger","start":46.618,"end":47.87}]},
    {"text":"That is kindness.","start":47.87,"end":51.04,"words":[{"w":"That","start":47.87,"end":48.813},{"w":"is","start":48.863,"end":49.436},{"w":"kindness","start":49.486,"end":51.04}]},
    {"text":"It is not magic.","start":51.04,"end":54.77,"words":[{"w":"It","start":51.04,"end":51.719},{"w":"is","start":51.769,"end":52.448},{"w":"not","start":52.498,"end":53.407},{"w":"magic","start":53.457,"end":54.77}]},
    {"text":"And it does not always feel easy.","start":54.77,"end":61.95,"words":[{"w":"And","start":54.77,"end":55.621},{"w":"it","start":55.671,"end":56.307},{"w":"does","start":56.357,"end":57.403},{"w":"not","start":57.453,"end":58.304},{"w":"always","start":58.354,"end":59.756},{"w":"feel","start":59.806,"end":60.853},{"w":"easy","start":60.903,"end":61.95}]},
    {"text":"Sometimes kindness means sharing.","start":61.95,"end":65.88,"words":[{"w":"Sometimes","start":61.95,"end":63.059},{"w":"kindness","start":63.109,"end":64.128},{"w":"means","start":64.178,"end":64.904},{"w":"sharing","start":64.954,"end":65.88}]},
    {"text":"Sometimes it means listening.","start":65.88,"end":69.71,"words":[{"w":"Sometimes","start":65.88,"end":67.109},{"w":"it","start":67.159,"end":67.576},{"w":"means","start":67.626,"end":68.431},{"w":"listening","start":68.481,"end":69.71}]},
    {"text":"Sometimes it means saying:","start":69.71,"end":74.03,"words":[{"w":"Sometimes","start":69.71,"end":71.232},{"w":"it","start":71.282,"end":71.797},{"w":"means","start":71.847,"end":72.844},{"w":"saying","start":72.894,"end":74.03}]},
    {"text":"\"I was wrong.\"","start":74.03,"end":77.9,"words":[{"w":"I","start":74.03,"end":74.62},{"w":"was","start":74.67,"end":75.971},{"w":"wrong","start":76.021,"end":77.9}]},
    {"text":"Or:","start":77.9,"end":79.4,"words":[{"w":"Or","start":77.9,"end":79.4}]},
    {"text":"\"I forgive you.\"","start":79.4,"end":82.19,"words":[{"w":"I","start":79.4,"end":79.77},{"w":"forgive","start":79.82,"end":81.323},{"w":"you","start":81.373,"end":82.19}]},
    {"text":"Kindness does not always win right away.","start":82.19,"end":89.22,"words":[{"w":"Kindness","start":82.19,"end":83.614},{"w":"does","start":83.664,"end":84.528},{"w":"not","start":84.578,"end":85.281},{"w":"always","start":85.331,"end":86.488},{"w":"win","start":86.538,"end":87.241},{"w":"right","start":87.291,"end":88.306},{"w":"away","start":88.356,"end":89.22}]},
    {"text":"But without kindness,","start":89.22,"end":91.6,"words":[{"w":"But","start":89.22,"end":89.688},{"w":"without","start":89.738,"end":90.601},{"w":"kindness","start":90.651,"end":91.6}]},
    {"text":"people drift apart.","start":91.6,"end":94.87,"words":[{"w":"people","start":91.6,"end":92.751},{"w":"drift","start":92.801,"end":93.811},{"w":"apart","start":93.861,"end":94.87}]},
    {"text":"Friendships break.","start":94.87,"end":97.91,"words":[{"w":"Friendships","start":94.87,"end":96.778},{"w":"break","start":96.828,"end":97.91}]},
    {"text":"Families fall apart.","start":97.91,"end":101.06,"words":[{"w":"Families","start":97.91,"end":99.225},{"w":"fall","start":99.275,"end":100.073},{"w":"apart","start":100.123,"end":101.06}]},
    {"text":"And the world becomes lonelier.","start":101.06,"end":105.53,"words":[{"w":"And","start":101.06,"end":101.644},{"w":"the","start":101.694,"end":102.278},{"w":"world","start":102.328,"end":103.172},{"w":"becomes","start":103.222,"end":104.297},{"w":"lonelier","start":104.347,"end":105.53}]},
    {"text":"So people keep discovering kindness,","start":105.53,"end":110.24,"words":[{"w":"So","start":105.53,"end":105.941},{"w":"people","start":105.991,"end":106.897},{"w":"keep","start":106.947,"end":107.624},{"w":"discovering","start":107.674,"end":109.075},{"w":"kindness","start":109.125,"end":110.24}]},
    {"text":"again and again,","start":110.24,"end":113.84,"words":[{"w":"again","start":110.24,"end":111.54},{"w":"and","start":111.59,"end":112.49},{"w":"again","start":112.54,"end":113.84}]},
    {"text":"because it helps us stay together.","start":113.84,"end":120.1,"words":[{"w":"because","start":113.84,"end":115.217},{"w":"it","start":115.267,"end":115.825},{"w":"helps","start":115.875,"end":116.956},{"w":"us","start":117.006,"end":117.564},{"w":"stay","start":117.614,"end":118.534},{"w":"together","start":118.584,"end":120.1}]},
    {"text":"We did not invent kindness.","start":120.1,"end":124.84,"words":[{"w":"We","start":120.1,"end":120.628},{"w":"did","start":120.678,"end":121.385},{"w":"not","start":121.435,"end":122.142},{"w":"invent","start":122.192,"end":123.357},{"w":"kindness","start":123.407,"end":124.84}]},
    {"text":"We only gave a name","start":124.84,"end":130.17,"words":[{"w":"We","start":124.84,"end":125.623},{"w":"only","start":125.673,"end":126.964},{"w":"gave","start":127.014,"end":128.304},{"w":"a","start":128.354,"end":128.83},{"w":"name","start":128.88,"end":130.17}]},
    {"text":"to something beautiful","start":130.17,"end":132.91,"words":[{"w":"to","start":130.17,"end":130.552},{"w":"something","start":130.602,"end":131.731},{"w":"beautiful","start":131.781,"end":132.91}]},
    {"text":"that was always possible.","start":132.91,"end":137.2,"words":[{"w":"that","start":132.91,"end":133.773},{"w":"was","start":133.823,"end":134.524},{"w":"always","start":134.574,"end":135.729},{"w":"possible","start":135.779,"end":137.2}]}
  ]
